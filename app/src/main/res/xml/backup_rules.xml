<?xml version="1.0" encoding="utf-8"?>
<!--
  The swap archive is the operator's only record of a day's work, so it is
  included in Auto Backup. osmdroid's tile cache is excluded because it is
  large, regenerable and would blow the 25 MB backup quota.
-->
<full-backup-content>
    <include domain="database" path="marti_takip.db" />
    <include domain="database" path="marti_takip.db-wal" />
    <include domain="database" path="marti_takip.db-shm" />
    <include domain="sharedpref" path="marti_takip_settings.preferences_pb" />
    <exclude domain="cache" path="." />
</full-backup-content>
