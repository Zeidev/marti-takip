<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Location is used exclusively for one-shot, event-based captures when the
      operator taps +1. No foreground/background location service is declared,
      so the OS will never keep the GPS chip awake for this app.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- OpenStreetMap tiles are downloaded on demand and cached on disk. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location is a nice-to-have: the app is fully usable without hardware. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <application
        android:name=".MartiTakipApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MartiTakip"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MartiTakip"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Shares the generated CSV archive as a content:// attachment.

          A CSV export cannot ride in EXTRA_TEXT: Intent extras travel in the
          Binder transaction, which tops out around 1 MB, so a multi-year
          archive made ACTION_SEND throw TransactionTooLargeException. The
          provider serves cacheDir/exports/ only (see xml/file_paths.xml) and is
          not exported, so the URI can only be read by the app the operator
          picks in the chooser, for as long as that grant lasts.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          osmdroid keeps its tile cache in the app-specific cache dir; no
          FileProvider is needed for that because nothing about the tiles is
          shared externally.
        -->
        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />
    </application>

</manifest>
